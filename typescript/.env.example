# AI_PROVIDER: Optional. LLM provider to use: "openrouter" (default) or "openai".
AI_PROVIDER="openrouter"

# OPENROUTER_API_KEY: Required for OpenRouter LLM API calls.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: Optional. Model id to use on OpenRouter (default: openai/gpt-oss-20b).
OPENROUTER_MODEL="openai/gpt-oss-20b"

# OPENAI_API_KEY / OPENAI_MODEL: Used when AI_PROVIDER="openai".
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o-mini"

# PORT: Optional. Server port (default: 3000).
PORT=3000
